{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web --workspace @kicks/mobile",
  "outputDirectory": "apps/mobile/dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(account|profile|permissions|opportunities|wallet|settings|engine)(/.*)?",
      "destination": "/index"
    }
  ],
  "installCommand": "npm ci --include=dev --workspaces"
}
