{
  "expo": {
    "name": "KICK’S",
    "slug": "kicks-app",
    "scheme": "kicks",
    "version": "0.2.6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withKicksVpn"
    ],
    "android": {
      "package": "com.datastorm.kicks",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#081A18"
      },
      "versionCode": 3
    },
    "extra": {
      "trafficMode": "demo"
    }
  }
}
