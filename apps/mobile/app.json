{
  "expo": {
    "name": "KICK’S",
    "slug": "kicks-app",
    "scheme": "kicks",
    "version": "0.2.6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "react-native-auth0",
        {
          "domain": "dev-dxqiztc3dpbtcfkd.us.auth0.com",
          "customScheme": "kicksauth"
        }
      ]
    ],
    "android": {
      "package": "com.datastorm.kicks",
      "adaptiveIcon": {
        "backgroundColor": "#081A18"
      }
    },
    "extra": {
      "trafficMode": "demo"
    },
    "ios": {
      "bundleIdentifier": "com.datastorm.kicks",
      "supportsTablet": true
    }
  }
}
