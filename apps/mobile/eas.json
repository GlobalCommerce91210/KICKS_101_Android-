{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "ios-device": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "KICKS_IOS_NATIVE_TUNNEL": "1",
        "EXPO_PUBLIC_IOS_API_URL": "https://staging-api.datastorminc.live",
        "EXPO_PUBLIC_TERMS_VERSION": "KC-CON-01-v1.0",
        "EXPO_PUBLIC_PRIVACY_VERSION": "KC-CON-02-v1.0"
      }
    },
    "ios-production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "KICKS_IOS_NATIVE_TUNNEL": "1"
      }
    }
  }
}
